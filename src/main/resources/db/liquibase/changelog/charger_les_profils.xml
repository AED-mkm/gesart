<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
>
    <changeSet  author="Wendkouny" id="202001221540">
        <createTable tableName="profil">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="libelle" type="varchar(50)"/>
            <column name="statut" type="varchar(50)"/>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
        </createTable>

        <loadData
                file="db/liquibase/data/profiles.csv"
                separator=";"
                tableName="profil">
            <column name="id" type="numeric"/>
            <column name="libelle" type="string"/>
            <column name="statut" type="string"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamp"/>
        </loadData>

    </changeSet>
</databaseChangeLog>
